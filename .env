# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Comma-separated list of origins allowed to call the API (admin panel, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# ── Database ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://admin:MDuf5WHaeBaugcUm@cluster0.bpqxlj3.mongodb.net/telentpro?retryWrites=true&w=majority

# ── Secrets ────────────────────────────────────────────────────────────────
# Separate signing secrets per audience so an employee token can never be
# mistaken for an admin token. Generate with: openssl rand -base64 48
JWT_EMPLOYEE_SECRET=4ePqhZUrwCOeRr4fjPRVb6BDs41VjOIML1/9dEmQift6DYVFR6kwbKyfUy+H4lqO
JWT_ADMIN_SECRET=RUumzhIbTxyf9I0MUhlNjd8VEbm3McCNJBuZ276aQjRLvHfZ2Q8dvOHW/4RaYTbb
# Peppers OTP hashes and encrypts provider credentials at rest.
OTP_PEPPER=yGCQsO+AjLkvxCOUnlobIEvWcOtZkpQ3vogbEITy+nc4oZX3qTl6iWQA2oZy66eg
SETTINGS_ENC_KEY=sUXuxMbH1p9frWt8GJ/7G28PQwpf1Fiogml6cnnNpU+lDW5/LDAdLOoG0Xw8isvg

# ── Token lifetimes ────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_EMPLOYEE=15m
ACCESS_TOKEN_TTL_ADMIN=8h
REGISTRATION_TOKEN_TTL=10m
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_REFRESH_TOKEN_TTL_DAYS=7

# ── Providers ──────────────────────────────────────────────────────────────
# mock | fast2sms | msg91
SMS_PROVIDER=mock
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# mock | fcm
PUSH_PROVIDER=mock
# Full service-account JSON, single-line, for FCM HTTP v1
FCM_SERVICE_ACCOUNT_JSON=

# ── Behaviour ──────────────────────────────────────────────────────────────
TIMEZONE=Asia/Kolkata
# Enables cron jobs in-process. Disable when running a separate worker dyno.
ENABLE_CRON=true
# Returns the OTP in the API response. Ignored entirely when NODE_ENV=production.
EXPOSE_OTP_IN_DEV=true

# Bootstrap admin, created by `npm run seed` if no admin exists.
SEED_ADMIN_EMAIL=jimit@mpowersolutions.in
SEED_ADMIN_PASSWORD=ChangeMe@123
SEED_ADMIN_NAME=Jimit Shah

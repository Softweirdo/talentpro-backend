# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4048
LOG_LEVEL=debug

# Comma-separated list of origins allowed to call the API (admin panel, etc.).
# An entry may use `*` as a single label wildcard — Cloudflare Pages gives every
# preview deploy its own `<hash>.talentpro-admin.pages.dev` hostname.
# Leave empty in development to accept any origin; in production an empty list
# rejects every browser origin.
# `localhost` and `127.0.0.1` are distinct origins to a browser, so the dev
# servers (Vite 5173, Expo web 8081) are listed under both spellings.
# The Android/iOS APK needs none of this: a native fetch sends no Origin
# header and no same-origin policy applies — only browsers are affected.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,http://localhost:8083,http://127.0.0.1:8083,https://talentpro-admin.pages.dev,https://*.talentpro-admin.pages.dev,https://talentpro-mobile.pages.dev,https://*.talentpro-mobile.pages.dev

# ── Database ───────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/telentpro

# ── Secrets ────────────────────────────────────────────────────────────────
# Separate signing secrets per audience so an employee token can never be
# mistaken for an admin token. Generate with: openssl rand -base64 48
JWT_EMPLOYEE_SECRET=change-me-employee-secret-at-least-32-characters-long
JWT_ADMIN_SECRET=change-me-admin-secret-at-least-32-characters-long
# Peppers OTP hashes and encrypts provider credentials at rest.
OTP_PEPPER=change-me-otp-pepper-at-least-32-characters-long
SETTINGS_ENC_KEY=change-me-settings-key-at-least-32-characters-long

# ── Token lifetimes ────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_EMPLOYEE=15m
ACCESS_TOKEN_TTL_ADMIN=8h
REGISTRATION_TOKEN_TTL=10m
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_REFRESH_TOKEN_TTL_DAYS=7

# ── Providers ──────────────────────────────────────────────────────────────
# mock | fast2sms | msg91 | twilio
SMS_PROVIDER=mock
FAST2SMS_API_KEY=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Twilio — Account SID + Auth Token from console.twilio.com, plus EITHER a
# Messaging Service SID (MG…, preferred; required for India DLT) OR a sender
# number in E.164. Indian recipients need DLT-registered sender + templates.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM=
# Twilio Verify service (VA…): Twilio sends and checks login OTPs itself.
TWILIO_VERIFY_SERVICE_SID=
# Optional: delivery reports. The API's public URL + /api/v1/webhooks/twilio/status
TWILIO_STATUS_CALLBACK_URL=

# mock | fcm
PUSH_PROVIDER=mock
# Full service-account JSON, single-line, for FCM HTTP v1
FCM_SERVICE_ACCOUNT_JSON=

# google | off — translates English job postings to Gujarati for the app.
# With no key, Google's keyless public endpoint is used (fine for low volume,
# but unofficial and rate-limited). Set a Cloud Translation API key for production.
TRANSLATE_PROVIDER=google
GOOGLE_TRANSLATE_API_KEY=

# ── Behaviour ──────────────────────────────────────────────────────────────
TIMEZONE=Asia/Kolkata
# Enables cron jobs in-process. Disable when running a separate worker dyno.
ENABLE_CRON=true
# Returns the OTP in the API response. Ignored entirely when NODE_ENV=production.
EXPOSE_OTP_IN_DEV=true
# Every number's OTP while SMS_PROVIDER=mock, production included — anyone
# holding this code can sign in as any mobile number. Empty or unset means
# random codes. Switching SMS_PROVIDER to msg91/fast2sms/twilio disables it automatically;
# setting it empty disables it outright. Must be 6 digits or empty.
#OTP_FIXED_CODE=123456

# Bootstrap admin, created by `npm run seed` if no admin exists.
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_NAME=Jimit Shah
